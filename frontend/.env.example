# Backend base URL (no trailing slash, no /api).
#
# Two deployment options:
#
# Option A — Same-origin proxy (recommended, avoids CORS + 3rd-party cookie issues):
#   Leave VITE_API_URL empty. The Vercel vercel.json proxies /api/* to your backend
#   via the VERCEL_API_URL env var. Cookies work as first-party.
#   VITE_API_URL=
#
# Option B — Cross-origin (separate backend host):
#   Set VITE_API_URL to your backend origin, e.g.
#   VITE_API_URL=https://study-tantra-api.railway.app
#   You must also set ALLOWED_ORIGIN=https://<your-vercel-app>.vercel.app
#   in your backend's env vars so CORS allows the frontend.
VITE_API_URL=

# Optional: Google sign-in (same OAuth client ID as the backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Optional: frontend error monitoring
VITE_SENTRY_DSN=