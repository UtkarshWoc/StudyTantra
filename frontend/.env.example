# Backend base URL (no trailing slash, no /api).
#
# Local development:
VITE_API_URL=http://localhost:5000
#
# Production (Vercel): set this in the Vercel project's Environment Variables
# (Production + Preview), then redeploy. Vite bakes it into the build, so
# changing it requires a new deployment.
#
# Vercel does NOT interpolate environment variables inside vercel.json, so a
# runtime proxy cannot be configured there from an env var. If you want the API
# on the same origin as the site (best for cookies), hardcode your backend in
# frontend/vercel.json and put that rewrite BEFORE the SPA rewrite:
#
#   { "source": "/api/(.*)", "destination": "https://your-backend.example.com/api/$1" }
#
# then set VITE_API_URL to the frontend origin (e.g. https://your-app.vercel.app).
# Otherwise leave VITE_API_URL pointing at the backend origin and set
# ALLOWED_ORIGIN on the backend to the frontend origin.

# Optional: Google sign-in (same OAuth client ID as the backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Optional: frontend error monitoring
VITE_SENTRY_DSN=
